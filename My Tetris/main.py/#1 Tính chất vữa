    handle_r = 9              # bán kính nút kéo

    # Vẽ nền thanh (màu xám)
    pygame.draw.rect(screen, GRAY, (bar_x, bar_y, bar_w, bar_h), border_radius=4)
    # Vẽ phần đã fill (màu xanh lá)
    fill_w = int(volume * bar_w)
    pygame.draw.rect(screen, COLOR_GREEN, (bar_x, bar_y, fill_w, bar_h), border_radius=4)
    # Vẽ nút kéo (hình tròn)
    handle_x = bar_x + fill_w
    pygame.draw.circle(screen, WHITE, (handle_x, bar_y + bar_h // 2), handle_r)

    # Hiển thị % âm lượng
    vol_pct = font_small.render(f"{int(volume * 100)}%", True, WHITE)
    screen.blit(vol_pct, (bar_x + bar_w + 8, bar_y - 2))

    # Rect để bắt sự kiện click/drag trên thanh (vùng rộng hơn thanh 1 chút)
    volume_bar_rect = pygame.Rect(bar_x, bar_y - 10, bar_w, bar_h + 20)

    exit_btn_rect = pygame.Rect(x + 40, y + 200, 240, 40)
    if exit_btn_img is not None:
        scaled_exit_btn = pygame.transform.scale(exit_btn_img, (exit_btn_rect.width, exit_btn_rect.height))
        screen.blit(scaled_exit_btn, (exit_btn_rect.x, exit_btn_rect.y))
    else:
        pygame.draw.rect(screen, (192, 57, 43), exit_btn_rect, border_radius=6)
        txt_e = font_medium.render("Exit Game", True, WHITE)
        screen.blit(txt_e, (exit_btn_rect.x + (exit_btn_rect.width - txt_e.get_width())//2, exit_btn_rect.y + 7))
    
    hint_txt = font_small.render("* Press any key to resume game", True, (180, 180, 200))
    screen.blit(hint_txt, (x + (w - hint_txt.get_width())//2, y + 245))
    
    return sound_btn_rect, exit_btn_rect, volume_bar_rect

# =====================================================================
#  9. HÀM NÚT BẤM BÀN PHÍM RIÊNG CHO PAUSE (ENTER TO PAUSE)
# =====================================================================
def handle_pause_input(event, current_state):
    if event.type == pygame.KEYDOWN:
        if event.key == pygame.K_RETURN:  
            if current_state == "PLAYING":
                return "PAUSED"
            elif current_state == "PAUSED":
                return "PLAYING"
    return current_state

def init_background_music(path, volume):
    
    try:
        pygame.mixer.music.load(path)
        pygame.mixer.music.set_volume(volume)
        pygame.mixer.music.play(-1)  # Tham số -1 giúp nhạc tự động lặp lại liên tục
        print(f"🎵 Đã bật nhạc nền: {path}")
    except Exception as e:
        print(f"⚠️ Không thể nạp nhạc nền ({path}): {e}. Chơi game không có nhạc.")

def stop_background_music():
    
    if pygame.mixer.music.get_busy():
        pygame.mixer.music.stop()
        print("🛑 Đã dừng nhạc nền do trò chơi kết thúc.")

def main():
    init_board()

    score      = 0
    lines_done = 0
    level      = 1
    fall_time  = 0
    fall_speed = 500
    high_score = 0  

    game_state = "PLAYING" 
    sound_on   = True      
    volume     = MUSIC_VOLUME   # --- NHẠC NỀN: Biến lưu âm lượng (0.0 → 1.0), chỉnh tại MUSIC_VOLUME ---
    dragging_volume = False     # --- NHẠC NỀN: Đang kéo thanh âm lượng không? ---

    is_brick      = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
    current_block = Block(is_brick)

    is_brick_next = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
    next_block    = Block(is_brick_next)

    # --- NHẠC NỀN: Bắt đầu khi trò chơi khởi động ---
    init_background_music(MUSIC_PATH, MUSIC_VOLUME)

    running = True
    while running:
        current_time = pygame.time.get_ticks()

        if game_state == "PLAYING":
            handle_mortar_flow()
            check_glue_reaction()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            
            game_state = handle_pause_input(event, game_state)
                
            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                mx, my = event.pos
                
                if game_state == "PLAYING":
                    if get_button_rect(SETTING_BTN_X, SETTING_BTN_Y, BTN_SIZE, BTN_SIZE).collidepoint(mx, my):
                        game_state = "SETTINGS"
                        
                elif game_state == "SETTINGS":
                    sound_rect, exit_rect, vol_rect = draw_setting_popup(sound_on, volume)
                    if sound_rect.collidepoint(mx, my):
                        sound_on = not sound_on
                        # --- NHẠC NỀN: Bật/tắt nhạc khi bấm nút Sound ---
                        if sound_on:
                            pygame.mixer.music.set_volume(volume)
                        else:
                            pygame.mixer.music.set_volume(0)
                    elif vol_rect.collidepoint(mx, my):
                        dragging_volume = True   # bắt đầu kéo thanh âm lượng
                    elif exit_rect.collidepoint(mx, my):
                        print("Quay trở lại màn hình chờ (Hành động giữ chỗ)...")
                        
                elif game_state == "GAMEOVER":
                    play_rect, back_rect = draw_lose_popup(score, high_score)
                    if play_rect.collidepoint(mx, my):
                        init_board()
                        score = 0
                        lines_done = 0
                        level = 1
                        fall_speed = 500
                        is_brick = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
                        current_block = Block(is_brick)
                        init_background_music(MUSIC_PATH, MUSIC_VOLUME)  # --- NHẠC NỀN: Phát lại khi chơi lại ---
                        game_state = "PLAYING"
                    elif back_rect.collidepoint(mx, my):
                        print("Quay trở lại màn hình chờ...")

            # --- NHẠC NỀN: Thả chuột → dừng kéo thanh âm lượng ---
            elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
                dragging_volume = False

            # --- NHẠC NỀN: Di chuyển chuột → cập nhật âm lượng nếu đang kéo ---
            elif event.type == pygame.MOUSEMOTION:
                if dragging_volume and game_state == "SETTINGS":
                    bar_x = (SCREEN_WIDTH - 320) // 2 + 40   # phải khớp với bar_x trong draw_setting_popup
                    bar_w = 240
                    mx_now = event.pos[0]
                    # Tính volume từ vị trí chuột, kẹp trong [0.0, 1.0]
                    volume = max(0.0, min(1.0, (mx_now - bar_x) / bar_w))
                    if sound_on:
                        pygame.mixer.music.set_volume(volume)   # áp dụng ngay lập tức

            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_q:
                    running = False
                
                if game_state == "SETTINGS":
                    game_state = "PLAYING"
                
                elif game_state == "PLAYING":
                    if event.key in (pygame.K_LEFT, pygame.K_a) and can_move(current_block, -1, 0):
                        current_block.x -= 1
                    elif event.key in (pygame.K_RIGHT, pygame.K_d) and can_move(current_block, 1, 0):
                        current_block.x += 1
                    elif event.key in (pygame.K_UP, pygame.K_w):
                        current_block.rotate()
                        if not can_move(current_block, 0, 0):
                            for _ in range(3):
                                current_block.rotate()
                    elif event.key in (pygame.K_DOWN, pygame.K_s):
                        fall_speed = 50

        if game_state == "PLAYING":
            if current_time - fall_time > fall_speed:
                if can_move(current_block, 0, 1):
                    current_block.y += 1
                else:
                    place_block(current_block)
                    removed     = remove_lines()
                    lines_done += removed
                    score      += removed * 100 * level
                    level       = lines_done // 10 + 1   
                    fall_speed  = max(100, 500 - (level - 1) * 40) 

                    current_block = next_block
                    is_brick_next = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
                    next_block    = Block(is_brick_next)
                    fall_speed    = max(100, 500 - (level - 1) * 40)

                    if not can_move(current_block, 0, 0):
                        if score > high_score:
                            high_score = score
                        stop_background_music()   # --- NHẠC NỀN: Dừng khi thua ---
                        game_state = "GAMEOVER"

                fall_time = current_time

        draw_background_screen()   
        draw_board()       
        draw_block(current_block)  
        draw_left_panel(score, level)   
        draw_right_panel(next_block)                

        if game_state == "PAUSED":
            draw_pause_overlay()
        elif game_state == "SETTINGS":
            draw_setting_popup(sound_on, volume)
        elif game_state == "GAMEOVER":
            draw_lose_popup(score, high_score)

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()