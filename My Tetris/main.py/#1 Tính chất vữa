def load_background(path, target_w, target_h):
    try:
        img = pygame.image.load(path).convert()
        scaled = pygame.transform.scale(img, (target_w, target_h))
        return scaled
    except Exception as e:
        return None

def load_widget_image(path):
    if path is None:
        return None
    try:
        return pygame.image.load(path).convert_alpha()
    except Exception as e:
        return None

def load_icon_image(path, size_w, size_h):
    if path is None:
        return None
    try:
        img = pygame.image.load(path).convert_alpha()
        return pygame.transform.scale(img, (size_w, size_h))
    except Exception as e:
        return None

