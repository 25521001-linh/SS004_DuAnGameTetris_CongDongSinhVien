import pygame
import random
import time
import sys

pygame.init()

# Constants
H = 20
W = 15
CELL_SIZE = 25
SCREEN_WIDTH = W * CELL_SIZE + 200
SCREEN_HEIGHT = H * CELL_SIZE
FPS = 60

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GRAY = (128, 128, 128)
RED = (200, 50, 50)        # Gạch - ĐỎ
DARK_GRAY = (80, 80, 80)   # Vữa - XÁM ĐẬM  
BLUE = (50, 150, 255)      # Gạch dính vữa - XANH DƯƠNG
BROWN = (139, 69, 19)      # Vữa khô (vữa + vữa)
GREEN = (0, 255, 0)        # Gạch siêu cứng (gạch + gạch dính)
PURPLE = (150, 50, 200)    # Random fill

screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Tetris - Gạch & Vữa v2.1 - 3:1")
clock = pygame.time.Clock()
font = pygame.font.Font(None, 36)

# Board state
board = [[' '] * W for _ in range(H)]
mortar_placed_time = [[0] * W for _ in range(H)]
block_durability = [[1] * W for _ in range(H)]

brick_templates = [
    [['B', 'B', 'B', 'B']], [[' ', 'G', 'G'], ['G', 'G', ' ']],
    [[' ', 'B', ' '], ['B', 'B', 'B']], [[' ', 'B', 'B'], ['B', 'B', ' ']],
    [['B', 'B', ' '], [' ', 'B', 'B']], [['B', ' ', ' '], ['B', ' ', ' '], ['B', 'B', ' ']],
    [[' ', ' ', 'B'], [' ', ' ', 'B'], ['B', 'B', ' ']]
]

mortar_templates = [
    [['M', 'M', 'M', 'M']], [[' ', 'V', 'V'], ['V', 'V', ' ']],
    [[' ', 'M', ' '], ['M', 'M', 'M']], [[' ', 'M', 'M'], ['M', 'M', ' ']],
    [['M', 'M', ' '], [' ', 'M', 'M']], [['M', ' ', ' '], ['M', ' ', ' '], ['M', 'M', ' ']],
    [[' ', ' ', 'M'], [' ', ' ', 'M'], ['M', 'M', ' ']]
]

class Block:
    def __init__(self, is_brick=True):
        self.is_brick = is_brick
        self.templates = brick_templates if is_brick else mortar_templates
        self.shape = random.choice(self.templates)
        self.x = W // 2 - 2
        self.y = 0
        
    def rotate(self):
        rotated = list(zip(*self.shape[::-1]))
        self.shape = [list(row) for row in rotated]

def init_board():
    for i in range(H):
        for j in range(W):
            if i == H - 1 or j == 0 or j == W - 1:
                board[i][j] = '#'
            else:
                board[i][j] = ' '

def can_move(block, dx, dy):
    for i, row in enumerate(block.shape):
        for j, cell in enumerate(row):
            if cell != ' ':
                tx, ty = block.x + j + dx, block.y + i + dy
                if tx < 1 or tx >= W - 1 or ty >= H - 1:
                    return False
                if board[ty][tx] != ' ':
                    return False
    return True

def place_block(block):
    """Đặt block và set thời gian cho vữa (kể cả block đầu tiên)"""
    for i, row in enumerate(block.shape):
        for j, cell in enumerate(row):
            if cell != ' ':
                x_pos, y_pos = block.x + j, block.y + i
                if 0 <= y_pos < H and 0 <= x_pos < W:
                    current_time = pygame.time.get_ticks()
                    
                    if not block.is_brick:  # VỮA - luôn set thời gian
                        board[y_pos][x_pos] = 'M'
                        mortar_placed_time[y_pos][x_pos] = current_time  # BẮT ĐẦU ĐẾM 3.5s
                    else:  # GẠCH
                        board[y_pos][x_pos] = 'B'
                        # Kiểm tra vữa bên dưới NGAY LẬP TỨC
                        if (y_pos + 1 < H and board[y_pos + 1][x_pos] == 'M'):
                            board[y_pos + 1][x_pos] = 'X'  # Gạch dính vữa
                            block_durability[y_pos + 1][x_pos] = 2
                            board[y_pos][x_pos] = 'B'  # Gạch vẫn ở trên

def find_falling_brick_above(i, j):
    """Tìm gạch nằm TRÊN vữa tại (i,j)"""
    for above_i in range(i - 1, -1, -1):
        if board[above_i][j] in ['B', 'S']:
            return above_i
    return None

def fill_random_hole(i, j):
    if board[i][j] == ' ' and random.random() < 0.6:
        board[i][j] = 'R'

def handle_mortar_flow():
    """Xử lý vữa chảy + tương tác"""
    current_time = pygame.time.get_ticks()
    for i in range(H - 2, 0, -1):
        for j in range(1, W - 1):
            if (board[i][j] == 'M' and 
                current_time - mortar_placed_time[i][j] > 3500):
                
                below_i, below_j = i + 1, j
                
                # LOGIC CHÍNH:
                if board[below_i][below_j] == ' ':  # Trống
                    # Gạch trên rơi theo
                    brick_above = find_falling_brick_above(i, j)
                    if brick_above is not None:
                        board[brick_above][j] = ' '
                        board[brick_above + 1][j] = 'B'
                    
                    # Vữa chảy xuống
                    board[below_i][below_j] = 'M'
                    mortar_placed_time[below_i][below_j] = current_time
                    board[i][j] = ' '
                    mortar_placed_time[i][j] = 0
                    
                    # Lấp random
                    fill_random_hole(i, j)
                    
                elif board[below_i][below_j] == 'B':  # Gặp GẠCH -> DÍNH
                    board[below_i][below_j] = 'X'  # Gạch dính vữa (2 lần clear)
                    block_durability[below_i][below_j] = 2
                    board[i][j] = ' '
                    
                elif board[below_i][below_j] == 'M':  # Gặp VỮA -> KHỐI CỨNG
                    board[below_i][below_j] = 'V'  # Vữa khô (1 lần clear)
                    block_durability[below_i][below_j] = 1
                    board[i][j] = ' '

def check_glue_reaction():
    """Gạch mới rơi vào gạch dính vữa -> siêu cứng"""
    for i in range(H):
        for j in range(1, W - 1):
            if board[i][j] == 'B':  # Gạch mới
                for di in [-1, 0, 1]:
                    for dj in [-1, 0, 1]:
                        ni, nj = i + di, j + dj
                        if (0 <= ni < H and 0 <= nj < W and 
                            board[ni][nj] == 'X'):  # Gặp gạch dính vữa
                            board[i][j] = 'S'  # Siêu cứng
                            block_durability[i][j] = 2
                            return

def remove_lines():
    lines_removed = 0
    i = H - 2
    while i > 0:
        full_line = all(board[i][j] != ' ' and board[i][j] != '#' 
                       for j in range(1, W - 1))
        
        if full_line:
            # Giảm độ bền TẤT CẢ cell trong dòng
            for j in range(1, W - 1):
                if block_durability[i][j] > 1:
                    block_durability[i][j] -= 1
                    if block_durability[i][j] == 1:
                        # Trở về trạng thái bình thường
                        if board[i][j] == 'S':
                            board[i][j] = 'B'  # Siêu cứng -> gạch thường
                        elif board[i][j] == 'X':
                            board[i][j] = 'B'  # Dính vữa -> gạch thường
                else:
                    board[i][j] = ' '
            
            # Shift lines
            for ii in range(i, 1, -1):
                for j in range(1, W - 1):
                    board[ii][j] = board[ii-1][j]
                    block_durability[ii][j] = block_durability[ii-1][j]
                    mortar_placed_time[ii][j] = mortar_placed_time[ii-1][j]
            lines_removed += 1
        else:
            i -= 1
    return lines_removed

def draw_board():
    color_map = {
        '#': GRAY,
        'B': RED,      # 🟥 Gạch đỏ
        'M': DARK_GRAY, # ⬜ Vữa xám đậm  
        'X': BLUE,     # 🔵 Gạch dính vữa
        'V': BROWN,    # 🟤 Vữa khô
        'S': GREEN,    # 🟢 Siêu cứng
        'R': PURPLE    # 🟣 Random fill
    }
    
    for i in range(H):
        for j in range(W):
            rect = pygame.Rect(j * CELL_SIZE, i * CELL_SIZE, CELL_SIZE, CELL_SIZE)
            if board[i][j] in color_map:
                pygame.draw.rect(screen, color_map[board[i][j]], rect)
            pygame.draw.rect(screen, WHITE, rect, 1)

def draw_block(block):
    color = RED if block.is_brick else DARK_GRAY
    for i, row in enumerate(block.shape):
        for j, cell in enumerate(row):
            if cell != ' ':
                rect = pygame.Rect((block.x + j) * CELL_SIZE, 
                                 (block.y + i) * CELL_SIZE, 
                                 CELL_SIZE, CELL_SIZE)
                pygame.draw.rect(screen, color, rect)
                pygame.draw.rect(screen, WHITE, rect, 1)

def draw_info(score, lines):
    info_text = [
        f"Score: {score}",
        f"Lines: {lines}",
        f"Ratio: 3:1 (Gach:Vua)",
        "",
        "🧱 + 💧 = 🔵X (2x)",
        "🧱 + 🔵X = 🟢S (2x)",
        "💧 + 💧 = 🟤V (1x)",
        "",
        "←→↑↓ / WASD / Q"
    ]
    
    for i, text in enumerate(info_text):
        surface = font.render(text, True, WHITE)
        screen.blit(surface, (W * CELL_SIZE + 10, 10 + i * 22))

def main():
    init_board()
    score = 0
    fall_time = 0
    fall_speed = 500
    
    # TỶ LỆ 3:1 GẠCH:VỮA
    is_brick = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]  # 75% gạch
    current_block = Block(is_brick)
    
    running = True
    while running:
        screen.fill(BLACK)
        current_time = pygame.time.get_ticks()
        
        handle_mortar_flow()
        check_glue_reaction()
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_q:
                    running = False
                if event.key in (pygame.K_LEFT, pygame.K_a) and can_move(current_block, -1, 0):
                    current_block.x -= 1
                elif event.key in (pygame.K_RIGHT, pygame.K_d) and can_move(current_block, 1, 0):
                    current_block.x += 1
                elif event.key in (pygame.K_UP, pygame.K_w):
                    current_block.rotate()
                    if not can_move(current_block, 0, 0):
                        for _ in range(3):
                            current_block.rotate()
                elif event.key in (pygame.K_DOWN, pygame.K_s):
                    fall_speed = 50
        
        # Auto fall
        if current_time - fall_time > fall_speed:
            if can_move(current_block, 0, 1):
                current_block.y += 1
            else:
                place_block(current_block)
                lines_removed = remove_lines()
                score += lines_removed * 100
                
                # TỶ LỆ 3:1 GẠCH:VỮA
                is_brick = random.choices([True, True, True, False], weights=[1,1,1,0.33])[0]
                current_block = Block(is_brick)
                fall_speed = 500
                
                if not can_move(current_block, 0, 0):
                    running = False
            
            fall_time = current_time
        
        draw_board()
        draw_block(current_block)
        draw_info(score, 0)
        
        pygame.display.flip()
        clock.tick(FPS)
    
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
