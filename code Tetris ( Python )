import random
import time
import curses

H = 20
W = 15

board = [[' '] * W for _ in range(H)]

score = 0  # 1. Khởi tạo biến điểm số
# Danh sách các khối cơ bản (7 khối chuẩn của Tetris)

block_templates = [
    [[' ', 'I', ' ', ' '], [' ', 'I', ' ', ' '], [' ', 'I', ' ', ' '], [' ', 'I', ' ', ' ']], # I
    [[' ', ' ', ' ', ' '], [' ', 'O', 'O', ' '], [' ', 'O', 'O', ' '], [' ', ' ', ' ', ' ']], # O
    [[' ', ' ', ' ', ' '], [' ', 'T', ' ', ' '], ['T', 'T', 'T', ' '], [' ', ' ', ' ', ' ']], # T
    [[' ', ' ', ' ', ' '], [' ', 'S', 'S', ' '], ['S', 'S', ' ', ' '], [' ', ' ', ' ', ' ']], # S
    [[' ', ' ', ' ', ' '], ['Z', 'Z', ' ', ' '], [' ', 'Z', 'Z', ' '], [' ', ' ', ' ', ' ']], # Z
    [[' ', 'J', ' ', ' '], [' ', 'J', ' ', ' '], ['J', 'J', ' ', ' '], [' ', ' ', ' ', ' ']], # J
    [[' ', 'L', ' ', ' '], [' ', 'L', ' ', ' '], [' ', 'L', 'L', ' '], [' ', ' ', ' ', ' ']]  # L
]

x = 4
y = 0
current_block = []

def rotate(block):
    # Thuật toán xoay ma trận 90 độ: [hàng][cột] -> [cột][đảo ngược hàng]
    new_block = [[' ' for _ in range(4)] for _ in range(4)]
    for r in range(4):
        for c in range(4):
            new_block[c][3 - r] = block[r][c]
    return new_block

def board_del_block():
    for i in range(4):
        for j in range(4):
            if current_block[i][j] != ' ' and 0 <= y + i < H and 0 <= x + j < W:
                board[y + i][x + j] = ' '

def block2board():
    for i in range(4):
        for j in range(4):
            if current_block[i][j] != ' ' and 0 <= y + i < H and 0 <= x + j < W:
                board[y + i][x + j] = current_block[i][j]

def init_board():
    for i in range(H):
        for j in range(W):
            if i == H - 1 or j == 0 or j == W - 1:
                board[i][j] = '#'
            else:
                board[i][j] = ' '

def draw(stdscr):
    stdscr.move(0, 0)
    for i in range(H):
        line = "".join(board[i])
        stdscr.addstr(i, 0, line)
    
    # 3. Hiển thị điểm số ở bên cạnh bảng game
    stdscr.addstr(2, W + 2, f"SCORE: {score}")
    stdscr.addstr(4, W + 2, "Controls:")
    stdscr.addstr(5, W + 2, "A/D: Left/Right")
    stdscr.addstr(6, W + 2, "W: Rotate")
    stdscr.addstr(7, W + 2, "X: Soft Drop")
    stdscr.addstr(8, W + 2, "Q: Quit")
    
    stdscr.refresh()

def can_move(dx, dy, block_to_check=None):
    if block_to_check is None:
        block_to_check = current_block
    for i in range(4):
        for j in range(4):
            if block_to_check[i][j] != ' ':
                tx = x + j + dx
                ty = y + i + dy
                if tx < 1 or tx >= W - 1 or ty >= H - 1:
                    return False
                if board[ty][tx] != ' ':
                    return False
    return True

def remove_line(stdscr):
    global score
    lines_cleared = 0
    i = H - 2
    while i > 0:
        if ' ' not in board[i][1:-1]: # Kiểm tra dòng đầy (bỏ qua biên #)
            lines_cleared += 1
            for ii in range(i, 0, -1):
                for jj in range(1, W - 1):
                    board[ii][jj] = board[ii - 1][jj]
            draw(stdscr)
            time.sleep(0.1)
        else:
            i -= 1
    
    # 2. Công thức tính điểm: 1 dòng=100, 2 dòng=300, 3 dòng=500, 4 dòng=800
    if lines_cleared == 1: score += 100
    elif lines_cleared == 2: score += 300
    elif lines_cleared == 3: score += 500
    elif lines_cleared == 4: score += 800

def main(stdscr):
    global x, y, current_block, score

    curses.curs_set(0)
    stdscr.nodelay(True)
    random.seed()
    
    current_block = random.choice(block_templates)
    init_board()

    while True:
        board_del_block()

        c = None
        try:
            c = stdscr.getkey()
        except:
            pass

        # Điều khiển
        if c == 'a' and can_move(-1, 0):
            x -= 1
        elif c == 'd' and can_move(1, 0):
            x += 1
        elif c == 'x' and can_move(0, 1):
            y += 1
            score += 1 # Thưởng nhẹ 1 điểm khi người chơi chủ động hạ khối nhanh
        elif c == 'w':
            rotated = rotate(current_block)
            if can_move(0, 0, rotated):
                current_block = rotated
        elif c == 'q':
            break

        # Trọng lực (tự rơi)
        if can_move(0, 1):
            y += 1
        else:
            block2board()
            remove_line(stdscr)
            x = 4
            y = 0
            current_block = random.choice(block_templates)
            # Kiểm tra thua cuộc
            if not can_move(0, 0):
                # Hiển thị thông báo kết thúc
                stdscr.addstr(H // 2, W // 4, " GAME OVER! ")
                stdscr.addstr(H // 2 + 1, W // 4, f" Total: {score} ")
                stdscr.refresh()
                time.sleep(2)
                break

        block2board()
        draw(stdscr)
        time.sleep(0.2)

curses.wrapper(main)